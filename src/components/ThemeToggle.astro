---
// ThemeToggle.astro — removed per Karthik's request
// Only dark mode remains
---

<script is:inline>
  // Force dark mode by setting the class on <html>
  // Run on initial load and after Astro view transitions
  function enforceDarkMode() {
    document.documentElement.classList.remove('light');
    document.documentElement.style.setProperty('color-scheme', 'dark');
  }

  // Run on every page change
  enforceDarkMode();
  document.addEventListener('astro:after-swap', enforceDarkMode);

  // Ensure dark mode persists even on reload
  localStorage.setItem('theme', 'dark');
</script>